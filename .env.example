# Copy this file to dashboard/.env.local for local use.
DATABASE_URL=postgresql://ujb:ujb@localhost:5432/ujb
SITE_PASSWORD=replace-with-a-long-personal-password
AUTH_SECRET=replace-with-at-least-32-random-bytes
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
CPP_EXTENSION_API_KEY=replace-with-a-different-random-secret

# Optional. WhatsApp remains local-only unless this is exactly "true".
ENABLE_WHATSAPP_WEB_SYNC=false
WHATSAPP_AGENT_API_KEY=replace-only-if-enabling-web-sync
WHATSAPP_SQLITE_PATH=../whatsapp/bridge/store/messages.db

