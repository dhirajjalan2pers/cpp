{
  "name": "lbs-personal-ujb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "migrate": "tsx scripts/migrate.ts",
    "doctor": "tsx scripts/doctor.ts",
    "fit": "tsx scripts/fit-score.ts",
    "whatsapp:sync": "uv --directory ../whatsapp/mcp run sync_postgres.py",
